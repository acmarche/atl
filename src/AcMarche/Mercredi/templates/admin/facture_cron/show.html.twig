{% extends '@AcMarcheMercrediAdmin/layout.html.twig' %}

{% block body %}
    <div class="card">
        <h3 class="card-header">Détails de la tâche planifiée du {{ factureCron.monthDate }}</h3>

        <div class="card-body">
            {% include '@AcMarcheMercrediAdmin/facture_cron/_actions.html.twig' %}

            <table class="table table-bordered">
                <tr>
                    <th>De</th>
                    <td>{{ factureCron.fromAdresse }}</td>
                </tr>
                <tr>
                    <th>Sujet</th>
                    <td>{{ factureCron.subject }}</td>
                </tr>
                <tr>
                    <th>Dernière syncro</th>
                    <td>
                        {% if factureCron.dateLastSync %}
                            {{ factureCron.dateLastSync|format_date('full') }}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Finis</th>
                    <td>{{ factureCron.done }}</td>
                </tr>
                <tr>
                    <th>Forcer l'envoi</th>
                    <td>{{ factureCron.force_send }}</td>
                </tr>
            </table>

            {{ factureCron.body|nl2br }}

            {% if factureCron.results.envoyees is defined %}
                <h4 class="text-success mt-3">Résultats des envois</h4>
                <p>
                    Factures envoyées : {{ factureCron.results.envoyees }}<br/>
                    Factures en erreur : {{ factureCron.results.erreurs|length }}
                </p>
                {% if factureCron.results.erreurs|length > 0 %}
                    <table class="table table-bordered">
                        <thead>
                        <tr>
                            <th>Facture</th>
                            <th>Tuteur</th>
                            <th>Erreur</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for erreur in factureCron.results.erreurs %}
                            <tr>
                                <td>
                                    <a href="{{ path('mercredi_admin_facture_show', {'id': erreur.facture}) }}">{{ erreur.facture }}</a>
                                </td>
                                <td>{{ erreur.tuteur }}</td>
                                <td class="text-danger">{{ erreur.erreur }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            {% endif %}

        </div>
    </div>
    {% include '@AcMarcheMercrediAdmin/facture_cron/_delete_form.html.twig' %}
{% endblock %}
