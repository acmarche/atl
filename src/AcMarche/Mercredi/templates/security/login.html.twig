{% extends '@AcMarcheMercredi/front/layout.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('bundles/acmarchemercredi/css/signin.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% set password_failed = error is not null %}
    <div class="login">
        <div class="login-card">

            {% include '@AcMarcheMercredi/security/_login_header.html.twig' with {
                heading: 'Se connecter',
                lead: 'à votre espace parent',
            } %}

            {# Email link: the default way in #}
            <section class="login-section" aria-labelledby="login-link-title">
                <h2 id="login-link-title" class="login-section-title">Recevoir un lien de connexion</h2>
                <p class="login-hint">
                    Pas besoin de mot de passe&#8239;: nous vous envoyons un lien par e-mail, il suffit de cliquer dessus.
                </p>
                <form method="post" action="{{ path('app_login_with_email') }}" data-turbo="false" novalidate
                      data-controller="submit-busy" data-action="submit-busy#submit">
                    <div class="mb-3">
                        <label for="login-email" class="form-label">Votre adresse e-mail</label>
                        <input type="email" name="email" id="login-email" value="{{ email }}"
                               class="form-control form-control-lg{{ email_error ? ' is-invalid' }}"
                               autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false"
                               required
                               {% if email_error %}aria-invalid="true" aria-describedby="login-email-error" autofocus{% endif %}>
                        {% if email_error %}
                            <p id="login-email-error" class="invalid-feedback d-block mb-0">{{ email_error }}</p>
                        {% endif %}
                    </div>
                    <button class="btn btn-primary btn-lg w-100" type="submit"
                            data-submit-busy-target="button" data-busy-label="Envoi en cours…">
                        Recevoir le lien
                    </button>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </form>
            </section>

            {# Password: secondary, revealed on demand #}
            <details class="login-alt" {% if password_failed %}open{% endif %}>
                <summary class="login-alt-toggle">J'ai un mot de passe</summary>

                <form method="post" action="{{ path('app_login') }}" class="login-alt-body"
                      data-controller="submit-busy" data-action="submit-busy#submit">
                    {% if password_failed %}
                        <p id="login-password-error" class="login-error">
                            {% if error.messageKey == 'Invalid credentials.' %}
                                Identifiant ou mot de passe incorrect. Vérifiez votre saisie, ou recevez plutôt un lien par e-mail.
                            {% else %}
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            {% endif %}
                        </p>
                    {% endif %}
                    <div class="mb-3">
                        <label for="login-username" class="form-label">Adresse e-mail ou nom d'utilisateur</label>
                        <input type="text" name="username" id="login-username" value="{{ last_username }}"
                               class="form-control{{ password_failed ? ' is-invalid' }}"
                               autocomplete="username" autocapitalize="none" spellcheck="false" required
                               {% if password_failed %}aria-invalid="true" aria-describedby="login-password-error"{% endif %}>
                    </div>
                    <div class="mb-2" data-controller="password-visibility">
                        <label for="login-password" class="form-label">Mot de passe</label>
                        <div class="input-group">
                            <input type="password" name="password" id="login-password"
                                   class="form-control{{ password_failed ? ' is-invalid' }}"
                                   autocomplete="current-password" required
                                   data-password-visibility-target="input"
                                   {% if password_failed %}aria-invalid="true" aria-describedby="login-password-error" autofocus{% endif %}>
                            <button type="button" class="btn btn-outline-secondary login-reveal" hidden
                                    data-password-visibility-target="toggle"
                                    data-action="password-visibility#toggle"
                                    aria-controls="login-password" aria-label="Afficher le mot de passe">
                                Afficher
                            </button>
                        </div>
                    </div>
                    <p class="mb-3 text-end">
                        <a href="{{ path('mercredi_front_forgot_password_request') }}" class="login-link">Mot de passe perdu&#8239;?</a>
                    </p>
                    <button class="btn btn-outline-primary w-100" type="submit"
                            data-submit-busy-target="button" data-busy-label="Connexion…">
                        Me connecter
                    </button>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </form>
            </details>

            <p class="login-foot">
                Pas encore de compte&#8239;? <a href="{{ path('mercredi_front_register') }}" class="login-link">Créer un compte</a>
            </p>
        </div>

        {% include '@AcMarcheMercredi/security/_login_help.html.twig' %}
    </div>
{% endblock %}
