{% extends '@AcMarcheMercredi/email/body.html.twig' %}
{% block subject %}{{ email.subject }}{% endblock %}

{% block content %}
    {% set resetUrl = url('mercredi_front_reset_password', {token: resetToken.token}) %}
    <p>Bonjour,</p>
    <p>
        Vous avez demandé une réinitialisation de votre mot de passe.
        Pour choisir un nouveau mot de passe, cliquez sur le bouton ci-dessous.
    </p>
    <p style="margin: 24px 0">
        <a href="{{ resetUrl }}" class="btn btn-primary">Réinitialiser mon mot de passe</a>
    </p>
    <p style="font-size: 14px; line-height: 22px">
        Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur&nbsp;:<br>
        <a href="{{ resetUrl }}" style="word-break: break-all">{{ resetUrl }}</a>
    </p>
    <p>Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer ce message.</p>
    <p style="margin: 0">Cordialement,<br>L'équipe</p>
{% endblock %}
