{% extends '@AcMarcheMercredi/email/body.html.twig' %}
{% block subject %}{{ email.subject }}{% endblock %}

{% block content %}

    Bonjour {{ user.prenom }} {{ user.nom }}
    <br/>
    <br/>

    Vous avez demandé un lien pour vous connecter au site.
