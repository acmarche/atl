{#
    Shared layout for every HTML email.
    Child templates fill `subject` (plain text) and `content`; `preheader` is optional.
    Styles in <head> are inlined by `inline_css`, so class-based styles in child
    templates (.alert, .btn, .list-group) also render in Gmail and Outlook.
#}
{% set org = organisation ?? null %}
{# Always show a sender name; same fallback as the front navbar #}
{% set org_name = org ? (org ~ '')|trim : '' %}
{% set org_name = org_name ?: 'Accueil Temps Libre' %}
{% set subject_text = block('subject')|striptags|trim %}
{% set preheader_text = block('preheader') is defined ? block('preheader')|striptags|trim : '' %}
{% apply inline_css %}
<!DOCTYPE html>
<html lang="fr" xmlns:v="urn:schemas-microsoft-com:vml">
<head>
    <meta charset="utf-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings xmlns:o="urn:schemas-microsoft-com:office:office">
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <style>
        td, th, div, p, a, h1 { font-family: "Segoe UI", Arial, sans-serif; mso-line-height-rule: exactly; }
    </style>
    <![endif]-->
    <title>{{ subject_text }}</title>
    <style>
        /* Content helpers used by child templates */
        .em-content p { margin: 0 0 16px; }
        .em-content a { color: #c2410c; text-decoration: underline; }
        .em-content strong { color: #18181b; }
        .alert {
            margin: 8px 0 16px;
            padding: 16px 20px;
            border: 1px solid #fed7aa;
            border-radius: 8px;
            background-color: #fff7ed;
        }
        .alert a { color: #9a3412; font-weight: 600; }
        .btn {
            display: inline-block;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            line-height: 20px;
            text-decoration: none;
        }
        .btn-primary { background-color: #c2410c; color: #ffffff; }
        .em-content a.btn-primary { color: #ffffff; text-decoration: none; }
        .list-group {
            margin: 0 0 16px;
            padding: 0;
            list-style: none;
            border: 1px solid #e4e4e7;
            border-radius: 8px;
        }
        .list-group-item { padding: 10px 16px; border-top: 1px solid #e4e4e7; }
        .list-group-item:first-child { border-top: 0; }
        .em-footer small { font-size: inherit; }
        .em-footer p { margin: 0; }

        @media (max-width: 600px) {
            .sm-px-0 { padding-left: 0 !important; padding-right: 0 !important; }
            .sm-w-full { width: 100% !important; }
            .sm-px-5 { padding-left: 20px !important; padding-right: 20px !important; }
            .sm-rounded-0 { border-radius: 0 !important; border-left: 0 !important; border-right: 0 !important; }
        }

        @media (prefers-color-scheme: dark) {
            .em-canvas { background-color: #18181b !important; }
            .em-card { background-color: #232326 !important; border-color: #3f3f46 !important; border-top-color: #ea5a0e !important; }
            .em-title, .em-content, .em-content strong { color: #f4f4f5 !important; }
            .em-brand, .em-content a { color: #fdba74 !important; }
            .em-muted { color: #a1a1aa !important; }
            .alert { background-color: #2c211a !important; border-color: #7c2d12 !important; }
            .alert a { color: #fdba74 !important; }
            .list-group, .list-group-item { border-color: #3f3f46 !important; }
        }
    </style>
</head>
<body class="em-canvas" style="margin: 0; padding: 0; width: 100%; background-color: #f4f4f5; -webkit-font-smoothing: antialiased; word-break: break-word">
{% if preheader_text %}
    <div style="display: none; max-height: 0; overflow: hidden">
        {{ preheader_text }}
        {% for i in 1..40 %}&#8199;&#65279;&#847; {% endfor %}
    </div>
{% endif %}
<div role="article" aria-roledescription="email" aria-label="{{ subject_text }}" lang="fr"
     class="em-canvas"
     style="background-color: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif">
    <table align="center" cellpadding="0" cellspacing="0" role="none" style="margin: 0 auto; width: 100%">
        <tr>
            <td align="center" class="sm-px-0" style="padding: 32px 16px">
                <table cellpadding="0" cellspacing="0" role="none" class="sm-w-full" style="width: 600px; max-width: 100%">
                    {# Card #}
                    <tr>
                        <td class="em-card sm-px-5 sm-rounded-0"
                            style="padding: 32px 40px 36px; background-color: #ffffff; border: 1px solid #e4e4e7; border-top: 4px solid #ea5a0e; border-radius: 0 0 12px 12px; text-align: left">
                            <p class="em-brand"
                               style="margin: 0 0 12px; font-size: 13px; font-weight: 600; line-height: 18px; color: #c2410c">
                                {{ org_name }}
                            </p>
                            <h1 class="em-title"
                                style="margin: 0 0 24px; font-size: 22px; font-weight: 700; line-height: 30px; letter-spacing: -0.01em; color: #18181b">
                                {{ block('subject') }}
                            </h1>
                            <div class="em-content"
                                 style="font-size: 16px; line-height: 26px; color: #27272a">
                                {% block content %}{% endblock %}
                            </div>
                        </td>
                    </tr>
                    {# Footer #}
                    <tr>
                        <td class="em-muted em-footer sm-px-5"
                            style="padding: 24px 40px 0; font-size: 13px; line-height: 20px; color: #52525b; text-align: left">
                            {% if org %}
                                <div style="margin: 0 0 12px">
                                    {% include '@AcMarcheMercrediAdmin/organisation/_signature.html.twig' with {organisation: org} %}
                                </div>
                            {% endif %}
                            <p style="margin: 0">&copy; {{ 'now'|date('Y') }} {{ org_name }}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
</body>
</html>
{% endapply %}
