{% extends '@AcMarcheMercredi/base.html.twig' %}

{% block title %}
    {{ render(path('mercredi_organisation_title')) }}
{% endblock %}

{% block brand %}
    {% set organisation_name = render(path('mercredi_organisation_title'))|trim %}
    <a class="navbar-brand" href="{{ path('mercredi_front_home') }}">
        <i class="fas fa-frog icon-rose d-inline-block align-text-top" aria-hidden="true"></i>
        <span class="ms-2 fs-4 navbar-text">{{ organisation_name ?: 'Accueil Temps Libre' }}</span>
    </a>
{% endblock %}

{% block menu_top %}
    {{ render(path('mercredi_front_menu_page')) }}
{% endblock %}
